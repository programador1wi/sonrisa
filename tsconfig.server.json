{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"],
    "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "skipLibCheck": true, "esModuleInterop": true,
    "outDir": "dist", "rootDir": ".", "sourceMap": true
  },
  "include": ["server", "shared"]
}
