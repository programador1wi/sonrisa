{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "shared", "tests", "scripts", "vite.config.ts", "playwright.config.ts", "vitest.config.ts"]
}
