{
  "name": "sonrisa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.13.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"node scripts/start-web-after-api.mjs\"",
    "start": "node dist/server/index.js",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:visual:live": "tsx scripts/live-evaluation.ts"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "10.1.4",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@google/genai": "2.24.0",
    "dotenv": "18.0.3",
    "fastify": "5.12.5",
    "lucide-react": "1.47.0",
    "openai": "7.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
