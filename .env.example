# Copiar a .env.local. Nunca usar prefijo VITE_ para secretos.
# Elegir explícitamente gemini u openai. No hay cambio automático de proveedor.
IMAGE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-pro-image
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-2.5-sunburst
# El proveedor y modelo quedan fijados al crear cada simulación.
PORT=3001
SONRISA_DATA_DIR=./data
